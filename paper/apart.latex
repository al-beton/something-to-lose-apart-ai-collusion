\vspace{-0.5ex}
\begin{list}{}{\setlength{\leftmargin}{0.5in}\setlength{\rightmargin}{0.5in}}\item\relax
$abstract$
\end{list}
$endif$

\vspace{0.1in}
{\setcounter{tocdepth}{2}\tableofcontents}
\clearpage

$body$

\end{document}
